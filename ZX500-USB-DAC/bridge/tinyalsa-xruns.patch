+/** Returns the number of XRUNs observed by tinyalsa for this PCM.
+ * This read-only accessor does not change recovery or the data path.
+ * @param pcm A PCM returned by @ref pcm_open, or NULL.
+ * @return The XRUN counter, or zero for NULL.
+ */
+int pcm_get_xruns(const struct pcm *pcm)
+{
+    return pcm ? pcm->xruns : 0;
+}
