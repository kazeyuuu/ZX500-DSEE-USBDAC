@@ -104,9 +104,31 @@
 # does not fully resynchronise without a reboot, so this is best-effort -- but
 # trying costs nothing, and not trying leaves the user with no USB at all.
 restore_usb_config(){
+  resume_usb_hal
   RC=$USBCFG_PREV
   case "$RC" in ''|none) RC=$(default_usb_config);; esac
   setprop sys.usb.config "$RC" 2>/dev/null
+}
+# Local ZX505 firmware service; stop only during exclusive DAC ownership.
+HAL_MARK=/dev/.zx-dac-usb-hal-owned
+pause_usb_hal(){
+  HS=$(getprop init.svc.usb-hal-1-1)
+  case "$HS" in running|restarting)
+    touch "$HAL_MARK" || return 1
+    stop usb-hal-1-1 || return 1;;
+    stopped) ;; *) return 1;;
+  esac
+  HI=0
+  while [ "$HI" -lt 30 ]; do
+    [ "$(getprop init.svc.usb-hal-1-1)" = stopped ] && return 0
+    sleep 0.1; HI=$((HI+1))
+  done
+  return 1
+}
+resume_usb_hal(){
+  [ -f "$HAL_MARK" ] || return 0
+  start usb-hal-1-1 || return 1
+  rm -f "$HAL_MARK"
 }
 clear_links(){ for l in "$G"/configs/b.1/*; do [ -L "$l" ] && rm -f "$l"; done; }
 
