 #!/system/bin/sh
-# ZX500 hi-res USB-DAC control (UAC2-only; keep the USB HAL running).
+# ZX505 4.08 USB-DAC control (UAC2-only; HAL restored on exit).
 #   usb-dac.sh on                  bring up the DAC now
